---
import '../styles/global.css';
import { GITHUB_USER, ROLE, SITE, SOCIAL } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050506" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.url)} />
    <link rel="icon" type="image/png" href={SITE.symbol} />
    <link rel="preload" as="image" href={SITE.logo} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={new URL(SITE.logo, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(SITE.logo, SITE.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      jobTitle: ROLE,
      email: SITE.email,
      url: SITE.url,
      image: new URL(SITE.logo, SITE.url).href,
      sameAs: SOCIAL.map((s) => s.href),
    })} />
  </head>
  <body class="min-h-dvh">
    <div class="relative z-10 flex min-h-dvh flex-col">
      <a class="skip-link" href="#contenido">Saltar al contenido</a>
      <header id="inicio" class="safe-inline mx-auto w-full max-w-[1600px] px-5 pt-6 sm:px-8 sm:pt-8 lg:px-12">
        <div class="flex items-center justify-between gap-5">
          <a
            href="#inicio"
            aria-label={SITE.name}
            class="inline-flex min-h-11 min-w-11 items-center justify-center transition-opacity hover:opacity-80"
          >
            <img
              src={SITE.symbol}
              alt=""
              width="48"
              height="48"
              class="size-12 object-contain"
            />
          </a>
          <nav aria-label="Navegación principal" class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm text-ink-300 sm:gap-x-7">
            <a href="#proyectos" class="min-h-11 inline-flex items-center transition-colors hover:text-accent">Proyectos</a>
            <a href="#sobre-mi" class="min-h-11 inline-flex items-center transition-colors hover:text-accent">Sobre mí</a>
            <a href="#contacto" class="min-h-11 inline-flex items-center transition-colors hover:text-accent">Contacto</a>
            {
              SOCIAL.map((s) =>
                s.icon ? (
                  <a
                    href={s.href}
                    rel="me noopener"
                    target="_blank"
                    aria-label={s.label}
                    class="hidden min-h-11 min-w-11 items-center justify-center transition-colors hover:text-accent sm:inline-flex"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 16 16"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
                      >
                      </path>
                    </svg>
                  </a>
                ) : (
                  <a class="inline-flex min-h-11 items-center transition-colors hover:text-accent" href={s.href} rel="me noopener noreferrer" target="_blank">
                    {s.label}
                  </a>
                )
              )
            }
          </nav>
        </div>
      </header>

      <slot />

      <footer class="site-footer safe-inline mt-auto px-5 pt-12 pb-8 sm:px-8 sm:pt-16 sm:pb-10 lg:px-12">
        <div class="mx-auto w-full max-w-[1504px]">
          <div aria-hidden="true" class="footer-wordmark select-none" data-reveal data-motion="footer-brand">
            <img src={SITE.logo} alt="" width="1056" height="1056" loading="lazy" />
          </div>
          <div class="mt-8 flex flex-wrap items-center justify-between gap-5 text-sm text-ink-300">
            <p>© {year} {SITE.name}</p>
            <nav aria-label="Enlaces del pie de página" class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href="#sobre-mi" class="transition-colors hover:text-white">Sobre mí</a>
              <a href="#proyectos" class="transition-colors hover:text-white">Proyectos</a>
              <a href="#contacto" class="transition-colors hover:text-white">Contacto</a>
            {
              SOCIAL.map((s) => (
                <a href={s.href} rel="me noopener noreferrer" target="_blank" aria-label={s.icon ? `${s.label}: ${GITHUB_USER}` : s.label} class="inline-flex min-h-11 items-center gap-2 transition-colors hover:text-white">
                  {s.icon && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
                    </svg>
                  )}
                  <span>{s.icon ? GITHUB_USER : s.label}</span>
                </a>
              ))
            }
            </nav>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (els.length && !calm) {
        els.forEach((el) => el.classList.add('reveal'));

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
